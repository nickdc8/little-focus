{
  "manifest_version": 3,
  "name": "Little Focus",
  "version": "1.0.0",
  "description": "A little time for what matters. A simple Pomodoro focus timer with breaks and desktop notifications.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "key": "",
  "action": {
    "default_title": "Little Focus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
